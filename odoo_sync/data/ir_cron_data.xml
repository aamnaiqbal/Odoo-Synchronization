<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Upgrade clean-up: the fetch-configuration cron of the previous version points to a
         model that no longer exists. Does nothing on a fresh install; can be removed once
         every database has been upgraded. -->
    <delete model="ir.cron" search="[('name', '=', 'Sync: process queued runs')]"/>

    <data noupdate="1">
        <!-- Local -> remote push worker. -->
        <record id="ir_cron_sync_queue_worker" model="ir.cron">
            <field name="name">Synchronization Queue Worker</field>
            <field name="model_id" ref="model_sync_queue"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_queue()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <!-- Remote -> local pull. Does nothing for a connection without "Pull From Remote". -->
        <record id="ir_cron_sync_pull_worker" model="ir.cron">
            <field name="name">Synchronization Pull Worker</field>
            <field name="model_id" ref="model_sync_connection"/>
            <field name="state">code</field>
            <field name="code">model._cron_pull()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>

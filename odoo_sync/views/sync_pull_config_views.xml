<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sync_pull_config_list" model="ir.ui.view">
        <field name="name">sync.pull.config.list</field>
        <field name="model">sync.pull.config</field>
        <field name="arch" type="xml">
            <list decoration-danger="last_error" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="model_id"/>
                <field name="remote_domain"/>
                <field name="include_binary" optional="show"/>
                <field name="track_deletes" optional="show"/>
                <field name="last_pull_date"/>
                <field name="last_pull_count"/>
                <field name="last_error" optional="show"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_sync_pull_config_form" model="ir.ui.view">
        <field name="name">sync.pull.config.form</field>
        <field name="model">sync.pull.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_pull_now" type="object" string="Pull Now" class="btn-primary"/>
                    <button
                        name="action_skip_failed"
                        type="object"
                        string="Skip Failed Record"
                        invisible="not failed_stamp"
                        confirm="The record that fails will not be pulled until it changes again on the remote. Continue?"
                    />
                    <button
                        name="action_init_cursor"
                        type="object"
                        string="Cursor From Local Data"
                        confirm="Restart from the newest record that came with the imported database. Continue?"
                    />
                    <button
                        name="action_reset_cursor"
                        type="object"
                        string="Full Resync"
                        confirm="The next pull fetches EVERY remote record again. Continue?"
                    />
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="not last_error">
                        <field name="last_error" nolabel="1"/>
                    </div>
                    <group>
                        <group string="What to pull">
                            <field name="active"/>
                            <field name="sequence"/>
                            <field name="model_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="remote_domain"/>
                            <field name="excluded_fields"/>
                            <field name="include_binary"/>
                        </group>
                        <group string="Behaviour">
                            <field name="batch_size"/>
                            <field name="overlap_seconds"/>
                            <field name="track_deletes"/>
                            <field name="reconcile_hours" invisible="not track_deletes"/>
                        </group>
                    </group>
                    <group string="Progress">
                        <group>
                            <field name="cursor_stamp"/>
                            <field name="cursor_id"/>
                            <field name="cursor_ready"/>
                        </group>
                        <group>
                            <field name="last_pull_date"/>
                            <field name="last_pull_count"/>
                            <field name="last_reconcile_date"/>
                            <field name="failed_id" invisible="not failed_stamp"/>
                            <field name="failed_stamp" invisible="not failed_stamp"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sync_pull_config_search" model="ir.ui.view">
        <field name="name">sync.pull.config.search</field>
        <field name="model">sync.pull.config</field>
        <field name="arch" type="xml">
            <search>
                <field name="model_id"/>
                <filter name="with_error" string="With Error" domain="[('last_error', '!=', False)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_sync_pull_config" model="ir.actions.act_window">
        <field name="name">Pull Models</field>
        <field name="res_model">sync.pull.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_sync_pull_config"
        name="Pull Models"
        parent="menu_sync_root"
        action="action_sync_pull_config"
        sequence="30"
    />

</odoo>

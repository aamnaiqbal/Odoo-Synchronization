<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sync_connection_form_pull" model="ir.ui.view">
        <field name="name">sync.connection.form.pull</field>
        <field name="model">sync.connection</field>
        <field name="inherit_id" ref="view_sync_connection_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_pull_now"
                    type="object"
                    string="Pull Now"
                    invisible="not pull_enabled or not baseline_date"
                />
            </xpath>
            <xpath expr="//group[@string='Worker']" position="after">
                <group string="Remote to Local (Pull)">
                    <field name="pull_enabled"/>
                    <field name="last_pull_date"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_sync_pull_cursor_list" model="ir.ui.view">
        <field name="name">sync.pull.cursor.list</field>
        <field name="model">sync.pull.cursor</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0">
                <field name="connection_id" readonly="1"/>
                <field name="model" readonly="1"/>
                <field name="last_write_date"/>
                <field name="last_id"/>
                <field name="last_run"/>
                <field name="created_count"/>
                <field name="updated_count"/>
                <field name="skipped_count"/>
                <field name="last_error"/>
            </list>
        </field>
    </record>

    <record id="action_sync_pull_cursor" model="ir.actions.act_window">
        <field name="name">Pull Cursors</field>
        <field name="res_model">sync.pull.cursor</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem
        id="menu_sync_pull_cursor"
        name="Pull Cursors"
        parent="menu_sync_root"
        action="action_sync_pull_cursor"
        sequence="40"
    />

</odoo>

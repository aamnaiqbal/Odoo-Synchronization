<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sync_queue_list" model="ir.ui.view">
        <field name="name">sync.queue.list</field>
        <field name="model">sync.queue</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="model_name"/>
                <field name="record_id"/>
                <field name="operation"/>
                <field name="state"/>
                <field name="retry_count"/>
                <field name="remote_id"/>
                <field name="next_retry_at"/>
            </list>
        </field>
    </record>

    <record id="view_sync_queue_form" model="ir.ui.view">
        <field name="name">sync.queue.form</field>
        <field name="model">sync.queue</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_retry"
                        type="object"
                        string="Retry"
                        class="btn-primary"
                    />

                    <button
                        name="action_reset_processing"
                        type="object"
                        string="Reset Processing"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="pending,processing,done,failed"
                    />
                </header>

                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="model_name"/>
                        <field name="record_id"/>
                        <field name="sync_uuid"/>
                        <field name="operation"/>
                    </group>

                    <group>
                        <field name="connection_id"/>
                        <field name="remote_id"/>
                        <field name="retry_count"/>
                        <field name="max_retries"/>
                        <field name="next_retry_at"/>
                    </group>

                    <group>
                        <field name="started_at"/>
                        <field name="completed_at"/>
                    </group>

                    <group>
                        <field name="last_error"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sync_queue" model="ir.actions.act_window">
        <field name="name">Synchronization Queue</field>
        <field name="res_model">sync.queue</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_sync_queue"
        name="Queue"
        parent="menu_sync_root"
        action="action_sync_queue"
        sequence="35"
    />

</odoo>
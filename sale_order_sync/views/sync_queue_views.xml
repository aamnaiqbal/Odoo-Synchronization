<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sync_queue_list" model="ir.ui.view">
        <field name="name">sync.queue.list</field>
        <field name="model">sync.queue</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'"
                  decoration-danger="state == 'failed'"
                  decoration-warning="state == 'pending'">
                <field name="order_id"/>
                <field name="connection_id"/>
                <field name="state"/>
                <field name="attempts"/>
                <field name="remote_id"/>
                <field name="done_date"/>
                <field name="last_error"/>
            </list>
        </field>
    </record>

    <record id="view_sync_queue_form" model="ir.ui.view">
        <field name="name">sync.queue.form</field>
        <field name="model">sync.queue</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_retry" type="object" string="Retry"
                            class="btn-primary" invisible="state == 'done'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="order_id"/>
                            <field name="connection_id"/>
                        </group>
                        <group>
                            <field name="attempts"/>
                            <field name="remote_id"/>
                            <field name="done_date"/>
                        </group>
                    </group>
                    <field name="last_error" placeholder="No error"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sync_queue" model="ir.actions.act_window">
        <field name="name">Sync Queue</field>
        <field name="res_model">sync.queue</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_sync_queue"
              name="Sync Queue"
              parent="base.menu_administration"
              action="action_sync_queue"
              groups="base.group_system"
              sequence="91"/>
</odoo>

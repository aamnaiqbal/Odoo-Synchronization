<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Safety net: retries anything left pending (e.g. after an outage).
         New orders also trigger this job immediately, see sync.queue._enqueue. -->
    <record id="ir_cron_sync_queue" model="ir.cron">
        <field name="name">Sync queue: push pending records to remote server</field>
        <field name="model_id" ref="model_sync_queue"/>
        <field name="state">code</field>
        <field name="code">model._cron_process()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>

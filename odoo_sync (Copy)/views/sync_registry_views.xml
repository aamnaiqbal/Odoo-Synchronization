<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sync_registry_list" model="ir.ui.view">
        <field name="name">sync.registry.list</field>
        <field name="model">sync.registry</field>
        <field name="arch" type="xml">
            <list>
                <field name="model_name"/>
                <field name="sync_key"/>
                <field name="remote_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_sync_registry" model="ir.actions.act_window">
        <field name="name">Synchronization Registry</field>
        <field name="res_model">sync.registry</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem
        id="menu_sync_registry"
        name="Registry"
        parent="menu_sync_root"
        action="action_sync_registry"
        sequence="50"
    />

</odoo>
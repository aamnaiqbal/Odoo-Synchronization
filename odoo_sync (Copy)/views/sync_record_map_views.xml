<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Record Mapping - List View -->
    <record id="sync_record_map_view_list" model="ir.ui.view">
        <field name="name">sync.record.map.list</field>
        <field name="model">sync.record.map</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="connection_id"/>
                <field name="model"/>
                <field name="local_id"/>
                <field name="remote_id"/>
                <field name="remote_xmlid"/>
                <field name="remote_write_date"/>
                <field name="last_synced"/>
            </list>
        </field>
    </record>

    <!-- Record Mapping - Search View -->
    <record id="sync_record_map_view_search" model="ir.ui.view">
        <field name="name">sync.record.map.search</field>
        <field name="model">sync.record.map</field>
        <field name="arch" type="xml">
            <search>
                <field name="model"/>
                <field name="local_id"/>
                <field name="remote_id"/>
                <field name="remote_xmlid"/>

                <group>
                    <filter name="group_model"
                        string="Model"
                        context="{'group_by': 'model'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Record Mapping - Action -->
    <record id="sync_record_map_action" model="ir.actions.act_window">
        <field name="name">Record Mapping</field>
        <field name="res_model">sync.record.map</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_sync_record_map"
            name="Record Mapping"
            parent="menu_sync_root"
            action="sync_record_map_action"
            sequence="40"/>

</odoo>